# user, password and database must equal POSTGRES_* in the root .env
DATABASE_URL=postgresql://jobtracker:replace-with-token-hex-16@postgres:5432/job_tracker

SECRET_KEY=replace-with-token-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
GEMINI_API_KEY=replace-with-your-gemini-key
BUCKET_NAME=replace-with-your-s3-bucket
# AWS_DEFAULT_REGION (eu-north-1) is set in docker-compose.prod.yml for api and worker.
# Do not add it here: the settings class rejects undeclared keys.

REDIS_URL=redis://redis:6379
CORS_ALLOWED_ORIGINS=http://localhost
ACTION_COOLDOWN_SECONDS=45

# the password in READONLY_DATABASE_URL must equal JOB_SEARCH_RO_PASSWORD
JOB_SEARCH_RO_PASSWORD=replace-with-another-token-hex-16
READONLY_DATABASE_URL=postgresql://job_search_ro:replace-with-another-token-hex-16@postgres:5432/job_tracker
JOB_SEARCH_STATEMENT_TIMEOUT_SECONDS=3
JOB_SEARCH_MAX_ROWS=50
JOB_SEARCH_COOLDOWN_SECONDS=5
